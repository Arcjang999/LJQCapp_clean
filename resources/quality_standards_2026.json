        "quantitative",
        "qualitative"
      ],
      "scales": [
        "concentration",
        "ct",
        "log",
        "qualitative",
        "other_numeric"
      ],
      "purposes": [
        "clinical"
      ],
      "requirements": [
        "按实验目的设置阴性、弱阳性及阳性等对照；基因分型另核对代表性位点。",
        "质控涉及提取、扩增、结果判读和异常处理。对照设置与统计浓度水平分别记录。"
      ],
      "automatic_evaluation": false
    },
    {
      "id": "wst494-2017-qualitative",
      "source_id": "wst494-2017",
      "kind": "qualitative",
      "name": "定性免疫精密度要求",
      "source_clause": "第1章；4.2.2—4.2.4",
      "source_page": "5、9",
      "techniques": [
        "immunoassay"
      ],
      "result_kinds": [
        "qualitative"
      ],
      "scales": [
        "s_co",
        "qualitative",
        "other_numeric"
      ],
      "purposes": [
        "clinical"
      ],
      "requirements": [
        "采用 C5—C95 灰区评价定性精密度；按 4.2.4 核对 C50±20% 范围要求。",
        "定性一致性和灰区要求不换算成浓度 CV。"
      ],
      "automatic_evaluation": false
    },
    {
