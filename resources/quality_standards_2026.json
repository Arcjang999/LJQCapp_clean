    {
      "source_id": "cdc-hcv-2023",
      "kind": "process",
      "test_item_codes": [
        "2600204A"
      ],
      "test_item_names": [
        "丙型肝炎病毒核酸测定",
        "丙型肝炎病毒核酸定量检测",
        "丙型肝炎病毒核酸定量测定",
        "丙型肝炎病毒RNA定量测定",
        "丙型肝炎病毒RNA测定",
        "HCV RNA",
        "HCV-RNA",
        "丙肝病毒RNA",
        "丙肝核酸"
      ],
      "source_clause": "前言；第四章1.1—1.2；第九章1.1—1.2、2、3.2、3.3.3、4.3",
      "source_page": "7、31—32、68—74",
      "techniques": [
        "realtime_pcr",
        "isothermal"
      ],
      "purposes": [
        "clinical"
      ],
      "automatic_evaluation": false,
      "id": "cdc-hcv-2023-rna-quantitative-iqc",
      "name": "丙肝病毒核酸定量室内质控",
      "result_kinds": [
        "quantitative"
      ],
      "scales": [
        "concentration",
        "log",
        "ct",
        "other_numeric"
      ],
      "requirements": [
        "每个检测批次使用试剂盒内部对照和非试剂盒组份的外部对照；内部对照限同批号试剂盒使用，结果无效须重新试验。",
        "外部对照的基质应与临床样品相同或相似，并具有可靠来源、均一性和稳定性。",
        "每个分析批至少检测一次质控品，并在发出该批结果前评价；对照位置应结合漂移与随机误差选择。",
        "定量检测每次设置阴性、弱阳性和阳性质控品。",
        "选择临床有意义的质控浓度；说明书标定值仅供参考，由实验室重复测定建立均值和标准差。",
        "质控图记录结果、中心线和控制界线，并关联时间、质控品、仪器、方法、试剂与校准物信息。更换试剂厂家、试剂批号或外部对照批次时重新建立质控图。"
      ],
      "method_terms": {
        "isothermal": [
          "TMA",
          "转录介导"
        ]
      }
    },
